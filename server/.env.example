# Copie para .env (nunca commite o .env). Valores reais ficam só no servidor.
PORT=3000
DATABASE_URL=postgres://mango:mango@localhost:5432/mango
STORAGE_DIR=./dados/fotos

# Área de admin (/admin): usuários criados na primeira subida, com esta senha inicial.
# A troca da senha é obrigatória no primeiro login. Sem ADMIN_SENHA_INICIAL, nenhum admin é criado.
# ADMIN_USUARIOS="raziel:Raziel,lucas:Lucas"
# ADMIN_SENHA_INICIAL=troque-por-uma-senha-forte

# Pagamento com Stripe (docs/PAGAMENTO-STRIPE.md). Sem STRIPE_SECRET_KEY o pagamento fica desligado e só o pacote grátis funciona.
# Use chaves de TESTE (sk_test_...) fora da produção. Não cole chave real em arquivo versionado nem em chat.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # do endpoint do webhook (ou do `stripe listen` em desenvolvimento)
# APP_URL=http://localhost:5173      # para onde o Stripe devolve o cliente depois do pagamento
